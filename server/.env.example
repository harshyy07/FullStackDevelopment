# OpportunityOS Server Configuration
PORT=5000

# MongoDB Connection String:
# For local MongoDB: mongodb://127.0.0.1:27017/opportunity_os
# For MongoDB Atlas (Free cloud DB): mongodb+srv://<username>:<password>@cluster0.mongodb.net/opportunity_os?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/opportunity_os

# Secret used to sign JSON Web Tokens
JWT_SECRET=opportunity_os_super_secret_jwt_key_2026

